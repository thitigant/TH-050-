generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Answer {
  id               String          @id
  responseId       String
  questionId       String
  selectedOptionId String?
  ratingValue      Int?
  textValue        String?
  Question         Question        @relation(fields: [questionId], references: [id])
  Response         Response        @relation(fields: [responseId], references: [id], onDelete: Cascade)
  QuestionOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([responseId, questionId])
}

model Question {
  id             String           @id
  surveyId       String
  displayOrder   Int
  type           QuestionType
  text           String
  isRequired     Boolean          @default(true)
  Answer         Answer[]
  Survey         Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  QuestionOption QuestionOption[]

  @@unique([surveyId, displayOrder])
  @@index([surveyId])
}

model QuestionOption {
  id           String   @id
  questionId   String
  displayOrder Int
  label        String
  Answer       Answer[]
  Question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, displayOrder])
  @@unique([questionId, label])
}

model Response {
  id           String   @id
  surveyId     String
  respondentId String
  submittedAt  DateTime @default(now())
  Answer       Answer[]
  User         User     @relation(fields: [respondentId], references: [id])
  Survey       Survey   @relation(fields: [surveyId], references: [id])

  @@unique([surveyId, respondentId])
  @@index([respondentId])
  @@index([surveyId])
}

model RevokedToken {
  jti       String   @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model Survey {
  id           String       @id
  ownerId      String
  title        String
  description  String?
  status       SurveyStatus @default(DRAFT)
  responseMode ResponseMode @default(IDENTIFIED)
  publishedAt  DateTime?
  closedAt     DateTime?
  closesAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  Question     Question[]
  Response     Response[]
  User         User         @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([status])
}

model User {
  id           String         @id
  email        String         @unique
  name         String
  passwordHash String
  role         Role
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  Response     Response[]
  RevokedToken RevokedToken[]
  Survey       Survey[]
}

enum Role {
  RESPONDENT
  SURVEY_OWNER
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  SINGLE_CHOICE
  RATING
  SHORT_TEXT
}

enum ResponseMode {
  IDENTIFIED
  ANONYMOUS
}
